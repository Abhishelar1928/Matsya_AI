# =============================================================================
# MatsyaAI Maharashtra — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in values.
# NEVER commit .env to version control.
# =============================================================================

# --- Application ---
ENVIRONMENT=development
APP_VERSION=0.1.0

# --- PostgreSQL / PostGIS ---
POSTGRES_USER=matsya
POSTGRES_PASSWORD=matsya_dev
POSTGRES_DB=matsya_ai
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://matsya:matsya_dev@db:5432/matsya_ai

# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# --- Data Sources (placeholders — do NOT invent real endpoints) ---
INCOIS_BASE_URL=
IMD_BASE_URL=
IMD_API_KEY=
IMD_DISTRICT_API_URL=https://api.imd.gov.in/api/v1/districtwarning
MAHARASHTRA_FISHERIES_BASE_URL=
PROTECTED_PLANET_API_TOKEN=

# --- Maharashtra Coastal Bounding Box (EPSG:4326) ---
MAHARASHTRA_MIN_LAT=15.0
MAHARASHTRA_MAX_LAT=20.6
MAHARASHTRA_MIN_LON=71.0
MAHARASHTRA_MAX_LON=74.2

# --- Map ---1
MAP_PROVIDER_KEY=

# --- Logging ---
LOG_LEVEL=INFO

COPERNICUS_MARINE_SERVICE_USERNAME=
COPERNICUS_MARINE_SERVICE_PASSWORD=